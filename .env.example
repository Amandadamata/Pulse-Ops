# Copy to .env and adjust. Never put .env in Git.
# Database password used by Compose (replace it with your own).
POSTGRES_PASSWORD=change-this-password

# Local port for the API/dashboard (127.0.0.1 only).
PULSEOPS_PORT=8000

# Turn on when PulseOps is behind HTTPS.
PULSEOPS_COOKIE_SECURE=false
PULSEOPS_SESSION_TTL_MINUTES=480
PULSEOPS_DISPLAY_TIMEZONE=America/Sao_Paulo
PULSEOPS_LOG_LEVEL=INFO

# Ports that monitors and webhooks may use.
PULSEOPS_ALLOWED_PORTS=80,443,8080,8443

# Worker
PULSEOPS_WORKER_CONCURRENCY=20
PULSEOPS_CHECK_RETENTION_DAYS=30
PULSEOPS_WEBHOOK_TIMEOUT_SECONDS=5
PULSEOPS_WEBHOOK_MAX_ATTEMPTS=6

# Only for networks with a corporate TLS proxy during the image build:
# PULSEOPS_EXTRA_CA_FILE=/path/to/ca.pem
