# Copie para .env e ajuste. Nunca coloque o .env no Git.
# Senha do banco usada pelo Compose (troque por uma senha sua).
POSTGRES_PASSWORD=troque-esta-senha

# Porta local da API/dashboard (só em 127.0.0.1).
PULSEOPS_PORT=8000

# Ative quando o PulseOps estiver atrás de HTTPS.
PULSEOPS_COOKIE_SECURE=false
PULSEOPS_SESSION_TTL_MINUTES=480
PULSEOPS_DISPLAY_TIMEZONE=America/Sao_Paulo
PULSEOPS_LOG_LEVEL=INFO

# Portas que os monitores e webhooks podem usar.
PULSEOPS_ALLOWED_PORTS=80,443,8080,8443

# Worker
PULSEOPS_WORKER_CONCURRENCY=20
PULSEOPS_CHECK_RETENTION_DAYS=30
PULSEOPS_WEBHOOK_TIMEOUT_SECONDS=5
PULSEOPS_WEBHOOK_MAX_ATTEMPTS=6

# Apenas para redes com proxy TLS corporativo durante o build da imagem:
# PULSEOPS_EXTRA_CA_FILE=/caminho/para/ca.pem
