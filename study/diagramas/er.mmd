erDiagram
    operators ||--o{ operator_sessions : "tem"
    monitors ||--o{ checks : "gera"
    monitors ||--o{ incidents : "tem"
    monitors ||--o{ health_changes : "registra"
    monitors ||--o{ coverage_gaps : "registra"
    incidents ||--o{ incident_events : "linha do tempo"
    incidents ||--o{ alert_events : "gera"
    alert_events ||--o{ deliveries : "uma por destino"
    alert_destinations ||--o{ deliveries : "recebe"
    deliveries ||--o{ delivery_attempts : "tentativas"
    checks |o--o{ incident_events : "referência opcional"
    checks |o--o{ health_changes : "referência opcional"
    checks |o--o{ incidents : "último check"

    operators {
        int id PK
        string username UK
        string password_hash
        timestamptz created_at
    }
    operator_sessions {
        string token_hash PK
        int operator_id FK
        string csrf_token
        timestamptz expires_at
    }
    monitors {
        int id PK
        string name "único entre não arquivados (lower)"
        string url
        string method "GET ou HEAD"
        int interval_seconds
        int timeout_seconds
        string accepted_status_codes
        int latency_threshold_ms
        int failure_threshold
        int recovery_threshold
        string state "active, paused, archived"
        string health "no_data, healthy, degraded, down, paused"
        string health_reason
        int consecutive_failures
        int consecutive_successes
        int config_version
        timestamptz next_run_at
        timestamptz archived_at
    }
    checks {
        bigint id PK
        int monitor_id FK
        string run_key UK
        string trigger "scheduled, manual"
        string status "running, completed"
        timestamptz scheduled_at
        timestamptz started_at
        int duration_ms
        int status_code
        string outcome
        string explanation
    }
    incidents {
        int id PK
        int monitor_id FK
        string status "open, resolved, closed"
        timestamptz started_at
        timestamptz confirmed_at
        timestamptz ended_at
        string opening_reason
        string resolution_explanation
        int failure_count
        bigint last_check_id FK
    }
    incident_events {
        int id PK
        int incident_id FK
        string kind
        timestamptz occurred_at
        jsonb details
        bigint check_id FK
    }
    health_changes {
        int id PK
        int monitor_id FK
        string from_health
        string to_health
        string reason
        bigint check_id FK
    }
    coverage_gaps {
        int id PK
        int monitor_id FK
        timestamptz gap_start
        timestamptz gap_end
        string reason
    }
    alert_destinations {
        int id PK
        string name UK
        string url
        bool enabled
    }
    alert_events {
        int id PK
        string event_key UK
        string kind
        int incident_id FK
        int monitor_id FK
        jsonb payload
    }
    deliveries {
        int id PK
        int event_id FK
        int destination_id FK
        string status
        int attempt_count
        timestamptz next_attempt_at
    }
    delivery_attempts {
        int id PK
        int delivery_id FK
        int attempt_number
        int status_code
        string result
        string error
    }
    worker_heartbeats {
        string worker_id PK
        string hostname
        int pid
        timestamptz last_seen_at
    }
